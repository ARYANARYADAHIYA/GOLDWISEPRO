# GoldWise Pro Environment Configuration Example
# Copy this file to .env for local overrides

# Environment mode ('development', 'staging', 'production')
ENVIRONMENT=production

# Database URL (Default uses SQLite with WAL mode. For Vercel Serverless, SQLite auto-falls back to /tmp)
# For managed Postgres, specify: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./goldwise_pro.db

# Storage Directories (Defaults to relative paths; uses /tmp on Vercel)
# STORAGE_DIR=./data_storage
# ARTIFACTS_DIR=./artifacts

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=*

# Statutory Transaction Friction Parameters (MCX Gold)
DEFAULT_BROKERAGE_BPS=1.5
DEFAULT_EXCHANGE_FEE_BPS=1.0
DEFAULT_GST_RATE=0.18
DEFAULT_SLIPPAGE_BPS=3.0
